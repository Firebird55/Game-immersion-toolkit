{
  "name": "game-immersion-toolkit",
  "version": "0.20.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:prepare": "node scripts/prepare-mobile-assets.mjs",
    "build": "node scripts/prepare-mobile-assets.mjs && vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --port 3000",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-mobile-assets.mjs && node --test tests/*.test.mjs",
    "test:python": "node scripts/python-tests.mjs",
    "test:infra": "node --test tests/check-selection.test.mjs tests/check-evidence.test.mjs tests/ci-gate.test.mjs tests/dev-doctor.test.mjs tests/python-runtime.test.mjs tests/e2e-preview.test.mjs tests/build-identity.test.mjs",
    "check": "npm run typecheck && npm test && npm run test:python && npm run build",
    "release": "node scripts/release.mjs",
    "lexirise:watch": "node scripts/lexirise-watch.mjs",
    "mobile:build": "node scripts/build-mobile-preview.mjs",
    "mobile:dev": "node scripts/serve-mobile-capture.mjs --local",
    "pairing:dev": "wrangler dev --config services/pairing/wrangler.jsonc --local",
    "pairing:deploy": "wrangler deploy --config services/pairing/wrangler.jsonc",
    "mobile:check": "node scripts/prepare-mobile-assets.mjs && node --test tests/mobile-publication.test.mjs tests/mobile-capture.test.mjs tests/mobile-library.test.mjs tests/mobile-pairing-qr.test.mjs tests/mobile-recovery.test.mjs tests/mobile-vault.test.mjs tests/mobile-gateway.test.mjs tests/mobile-transcript.test.mjs && node scripts/companion-e2e.mjs && node scripts/mobile-reader-layout-e2e.mjs && node scripts/mobile-capture-e2e.mjs && node scripts/mobile-recovery-e2e.mjs && node scripts/mobile-library-e2e.mjs && node scripts/mobile-update-e2e.mjs && node scripts/mobile-layout-e2e.mjs && node scripts/mobile-games-e2e.mjs && node scripts/ocr-packs-e2e.mjs",
    "audit:public": "node scripts/secret-check.mjs --public",
    "gateway:deploy": "wrangler deploy --config services/lexirise-gateway/wrangler.jsonc",
    "check:changed": "node scripts/check-changed.mjs",
    "check:full": "node scripts/check-changed.mjs --full",
    "docs:generate": "node scripts/generate-language-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "ocr:manifest": "node scripts/update-ocr-manifest.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@firebird55/lexirise-components": "file:vendor/lexirise-components",
    "@shadcn/react": "0.3.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.31.0",
    "ooz-wasm": "2.0.0",
    "opencc-js": "1.4.2",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.14.8",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.3.0",
    "xxhash-wasm": "1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "fflate": "0.8.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3"
  },
  "license": "SEE LICENSE IN LICENSE"
}
