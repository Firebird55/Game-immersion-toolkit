{
  "name": "game-immersion-toolkit",
  "version": "0.2.5",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --port 3000",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:python": "node scripts/python-tests.mjs",
    "check": "npm run typecheck && npm test && npm run test:python && npm run build",
    "release": "node scripts/release.mjs",
    "lexirise:watch": "node scripts/lexirise-watch.mjs",
    "mobile:build": "node scripts/build-mobile-preview.mjs",
    "mobile:dev": "node scripts/serve-mobile-capture.mjs --local",
    "mobile:check": "node --test tests/mobile-capture.test.mjs && node scripts/mobile-capture-e2e.mjs",
    "audit:public": "node scripts/secret-check.mjs --public"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.1.0",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "@firebird55/lexirise-components": "file:vendor/lexirise-components"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261009.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0",
    "playwright": "1.64.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3"
  },
  "license": "SEE LICENSE IN LICENSE"
}
