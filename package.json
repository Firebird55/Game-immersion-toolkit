{
  "name": "game-immersion-toolkit",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/prepare-mobile-assets.mjs && vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --port 3000",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-mobile-assets.mjs && node --test tests/*.test.mjs",
    "test:python": "node scripts/python-tests.mjs",
    "check": "npm run typecheck && npm test && npm run test:python && npm run build",
    "release": "node scripts/release.mjs",
    "lexirise:watch": "node scripts/lexirise-watch.mjs",
    "mobile:build": "node scripts/build-mobile-preview.mjs",
    "mobile:dev": "node scripts/serve-mobile-capture.mjs --local",
    "pairing:dev": "wrangler dev --config services/pairing/wrangler.jsonc --local",
    "pairing:deploy": "wrangler deploy --config services/pairing/wrangler.jsonc",
    "mobile:check": "node scripts/prepare-mobile-assets.mjs && node --test tests/mobile-capture.test.mjs tests/mobile-library.test.mjs tests/mobile-pairing-qr.test.mjs tests/mobile-recovery.test.mjs tests/mobile-vault.test.mjs tests/mobile-gateway.test.mjs tests/mobile-transcript.test.mjs && node scripts/companion-e2e.mjs && node scripts/mobile-reader-layout-e2e.mjs && node scripts/mobile-capture-e2e.mjs && node scripts/mobile-recovery-e2e.mjs && node scripts/mobile-library-e2e.mjs && node scripts/mobile-update-e2e.mjs && node scripts/mobile-layout-e2e.mjs",
    "audit:public": "node scripts/secret-check.mjs --public",
    "gateway:deploy": "wrangler deploy --config services/lexirise-gateway/wrangler.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@firebird55/lexirise-components": "file:vendor/lexirise-components",
    "@shadcn/react": "0.3.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jsqr": "1.4.0",
    "lucide-react": "1.31.0",
    "ooz-wasm": "2.0.0",
    "opencc-js": "1.4.2",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.1.0",
    "xxhash-wasm": "1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261009.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "fflate": "0.8.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.64.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3"
  },
  "license": "SEE LICENSE IN LICENSE"
}
