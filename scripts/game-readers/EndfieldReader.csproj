<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EndfieldReader.cs" />
    <Compile Include="$(EndfieldSource)/**/*.cs" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
  </ItemGroup>
  <Target Name="RequireSelectedSources" BeforeTargets="CoreCompile">
    <Error Condition="'$(EndfieldSource)' == ''" Text="A verified selected source directory is required." />
  </Target>
</Project>
